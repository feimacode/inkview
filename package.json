{
  "name": "@feimacode/inkview-workspace",
  "private": true,
  "version": "0.2.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build:ui": "vite build",
    "build:server": "node scripts/build-server.mjs",
    "build:sdk": "node scripts/build-sdk.mjs",
    "build": "npm run build:ui && npm run build:server && npm run build:sdk",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.server.json && tsc -p test/types/tsconfig.json && node scripts/docs-snippets.mjs && npm run typecheck -w @feimacode/inkview-sdk-example",
    "start": "node packages/inkview/dist/inkview.js --http",
    "start:stdio": "node packages/inkview/dist/inkview.js",
    "dev": "npm run build && node packages/inkview/dist/inkview.js --http",
    "test": "npm run build && node scripts/check-size.mjs && node scripts/smoke-test.mjs && node scripts/stdio-test.mjs && node scripts/http-test.mjs && node scripts/gen-guidance.mjs --check && node scripts/unit-test.mjs && npm run test:render",
    "tunnel": "bash scripts/tunnel.sh",
    "prepare": "npm run build",
    "inspect": "npx @modelcontextprotocol/inspector node packages/inkview/dist/inkview.js",
    "test:render": "DEV_PAGE=host vite build -c dev/vite.config.ts && node scripts/render-test.mjs",
    "preview": "node scripts/preview.mjs",
    "build:mcpb": "node scripts/build-mcpb.mjs",
    "gen:guidance": "node scripts/gen-guidance.mjs",
    "evals": "npm run build && node evals/run.mjs",
    "build:gallery": "npm run build:ui && DEV_PAGE=gallery vite build -c dev/vite.config.ts"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/core": "^2.4.0",
    "@modelcontextprotocol/express": "^2.0.2",
    "@modelcontextprotocol/ext-apps": "^2.0.4",
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "esbuild": "^0.28.2",
    "express": "^5.3.0",
    "playwright": "^1.63.0",
    "preact": "^10.29.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-singlefile": "^2.3.4",
    "zod": "^4.6.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/feimacode/inkview.git"
  }
}
